# Dépendances et build
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Secret / local — jamais commis
.env
.env.*
*.local
cookie.json

# État runtime du harness (journaux de sessions) — local par défaut ;
# les utilisateurs peuvent choisir de le versionner, le repo de dev non.
.nyworkflow/

# Sorties d'exécution des workspaces (e2e, démos locales) — le contenu
# écrit par l'agent est régénéré, seuls les .gitkeep sont versionnés.
examples/workspaces/**/outputs/*
!examples/workspaces/**/outputs/.gitkeep
examples/workspaces/**/notes/*
!examples/workspaces/**/notes/.gitkeep
examples/workspaces/**/research/*
!examples/workspaces/**/research/.gitkeep

# OS
.DS_Store
