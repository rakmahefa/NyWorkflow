# Dépendances et build
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Secret / local — jamais commis
.env
.env.*
*.local
cookie.json

# État runtime du harness (journaux de sessions, logs de profilage) — local
# par défaut ; les utilisateurs peuvent choisir de le versionner, le repo de
# dev non. Les logs de profilage (.logs/) vivent dedans : copiés dans le
# dépôt explicitement quand le pilote veut les partager.
.nyworkflow/

# Workspaces d'exemple (M14) : l'ICM vit dans le dossier caché .workspace/.
# Seuls les GABARITS de l'arbre ICM complet sont versionnés (charte, plan,
# tâches, journal, décisions, registre des sources, mémoire) ; tout ce que
# l'agent ÉCRIT (racine du projet comprise), les logs par session
# (.logs/<sessionId>/) et les workspaces e2e éphémères restent locaux.
examples/workspaces/**
!examples/workspaces/**/
!examples/workspaces/**/.workspace/
examples/workspaces/**/.workspace/**
!examples/workspaces/**/.workspace/CONTEXT.md
!examples/workspaces/**/.workspace/inbox/
!examples/workspaces/**/.workspace/inbox/CONTEXT.md
!examples/workspaces/**/.workspace/notes/
!examples/workspaces/**/.workspace/notes/CONTEXT.md
!examples/workspaces/**/.workspace/notes/plan.md
!examples/workspaces/**/.workspace/notes/tasks.md
!examples/workspaces/**/.workspace/notes/journal.md
!examples/workspaces/**/.workspace/notes/decisions.md
!examples/workspaces/**/.workspace/research/
!examples/workspaces/**/.workspace/research/CONTEXT.md
!examples/workspaces/**/.workspace/research/sources.md
!examples/workspaces/**/.workspace/memory/
!examples/workspaces/**/.workspace/memory/CONTEXT.md
!examples/workspaces/**/.workspace/memory/core.md
!examples/workspaces/**/.workspace/memory/lessons.md
!examples/workspaces/**/.workspace/outputs/
!examples/workspaces/**/.workspace/outputs/CONTEXT.md
!examples/workspaces/**/.workspace/archive/
!examples/workspaces/**/.workspace/archive/CONTEXT.md

