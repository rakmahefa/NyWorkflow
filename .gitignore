# Dépendances et build
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Secret / local — jamais commis
.env
.env.*
*.local
cookie.json

# État runtime du harness (journaux de sessions) — local par défaut ;
# les utilisateurs peuvent choisir de le versionner, le repo de dev non.
.nyworkflow/

# Sorties d'exécution des workspaces (runs, e2e, démos locales) — le
# contenu de output/ est régénéré, seuls les .gitkeep sont versionnés.
examples/workspaces/**/output/*
!examples/workspaces/**/output/.gitkeep

# OS
.DS_Store
