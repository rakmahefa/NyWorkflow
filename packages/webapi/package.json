{
  "name": "@nyworkflow/webapi",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "Passerelle webapi — interface web Gemini servie en OpenAI-compatible (refonte moderne de ny-gemini-acp)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "nyworkflow-webapi": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/cli.ts",
